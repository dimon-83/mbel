import {
  "dimon-83/mbel/ast",
  "dimon-83/mbel/builtin",
  "dimon-83/mbel/engine",
  "dimon-83/mbel/evaluator",
  "dimon-83/mbel/expr",
  "dimon-83/mbel/parser",
  "moonbitlang/core/json",
}

pkgtype(kind: "executable")

// Two artifacts from one source tree (proposal 0003 P0):
//
//   wasm-gc + js-string  → playground/mbel.wasm       (Node >= 24, browsers)
//   wasm (MVP)           → playground/mbel-cabi.wasm  (any MVP host)
//
// Both profiles list every ABI export; a missing entry is silently
// dead-code-eliminated (a 259-byte artifact exporting only `memory`), so
// tools/check_abi.mjs compares the artifact's exports against the manifest
// and would catch the omission.

options(
  link: {
    "wasm-gc": {
      "exports": [
        "abi_layout",
        "configure_session",
        "create_session",
        "describe_abi",
        "describe_functions",
        "describe_session",
        "disassemble",
        "dump_ast",
        "eval_checked",
        "eval_expr",
        "eval_jexl",
        "eval_session",
        "eval_with_functions",
        "eval_with_limits",
        "release_session",
      ],
      "use-js-builtin-string": true,
    },
    "wasm": {
      "exports": [
        "abi_layout",
        "configure_session",
        "create_session",
        "describe_abi",
        "describe_functions",
        "describe_session",
        "disassemble",
        "dump_ast",
        "eval_checked",
        "eval_expr",
        "eval_jexl",
        "eval_session",
        "eval_with_functions",
        "eval_with_limits",
        "release_session",
      ],
    },
  },
)
