// SPDX-License-Identifier: Apache-2.0
// Differential parity for the `matches` operator against Go's regexp
// (RE2), the reference implementation expr-lang itself uses.
//
// The cases and their expected verdicts are frozen in
// regex_re2_data_test.mbt, generated by tools/gen_regex_mbt.py from
// tools/regex_corpus.txt. Regenerate both when extending the corpus:
//
//     python3 tools/gen_regex_mbt.py && moon test -p engine_test
//
// Every row is checked on BOTH engines: the pattern is bound through the
// environment rather than embedded in the expression source, so no
// string-literal escaping sits between the corpus and the regex engine,
// and the dynamic-pattern path is exercised too.
//
// Only the match/no-match/error distinction is compared — Go and the core
// engine word their errors differently, and the corpus deliberately
// covers only the translated (supported) surface. Documented cuts live in
// evaluator/regex_translate_wbtest.mbt.

///|
fn re2_engine(mode : @engine.EngineMode) -> @engine.Engine {
  let e = @engine.new()
  @engine.Engine::set_engine(e, mode)
  e
}

///|
test "matches: RE2 differential parity on both engines" {
  let fails = StringBuilder::new()
  let mut ran = 0
  for row in regex_re2_cases {
    let (pattern, subject, expected) = row
    for mode in [@engine.Walk, @engine.Vm] {
      let mode_name = match mode {
        @engine.Walk => "walk"
        @engine.Vm => "vm"
      }
      let ctx : @ast.Value = @ast.ObjectVal([
        ("s", @ast.StrVal(subject)),
        ("p", @ast.StrVal(pattern)),
      ])
      let res = try? @engine.Engine::eval_expr(re2_engine(mode), "s matches p", ctx)
      ran += 1
      match res {
        Ok(@ast.BoolVal(got)) =>
          if got.to_string() != expected {
            fails.write_string(
              mode_name +
              " /" +
              pattern +
              "/ on " +
              subject +
              " : got " +
              got.to_string() +
              " want " +
              expected +
              "\n",
            )
          }
        Ok(v) =>
          fails.write_string(
            mode_name +
            " /" +
            pattern +
            "/ on " +
            subject +
            " : non-bool result " +
            @evaluator.to_string(v) +
            "\n",
          )
        Err(@engine.EngineErr(msg)) =>
          if expected != "error" {
            fails.write_string(
              mode_name +
              " /" +
              pattern +
              "/ on " +
              subject +
              " : expected " +
              expected +
              " but errored: " +
              msg +
              "\n",
            )
          }
        Err(_) =>
          fails.write_string(
            mode_name + " /" + pattern + "/ on " + subject + " : unknown error\n",
          )
      }
    }
  }
  if fails.to_string() != "" {
    inspect("ran=" + ran.to_string() + "\n" + fails.to_string(), content="")
  }
}
